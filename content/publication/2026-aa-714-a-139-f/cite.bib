        title = "{Wild is the wind from low-luminosity AGN: A jet-driven gas bubble blowing out a massive CO-dark outflow in ESO 420-G13}",
      journal = {\aap},
     keywords = {radiation mechanisms: non-thermal, techniques: high angular resolution, galaxies: active, galaxies: jets, galaxies: nuclei, infrared: ISM, Astrophysics of Galaxies},
