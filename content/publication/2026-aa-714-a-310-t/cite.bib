@ARTICLE{2026A&A...714A.310T,
       author = {{Tripodi}, Roberta and {Napolitano}, Lorenzo and {Pentericci}, Laura and {P{\'e}rez-D{\'\i}az}, Borja and {Bhagwat}, Aniket and {D'Eugenio}, Francesco and {Ar{\'e}valo-Gonz{\'a}lez}, Flor and {P{\'e}rez-Gonz{\'a}lez}, Pablo G. and {Arroyo-Polonio}, Antonio and {Calabr{\`o}}, Antonello and et al.},
        title = "{The collective voice of Ly{\ensuremath{\alpha}} emitters: Insights from stacked JWST spectroscopy}",
      journal = {\aap},
     keywords = {techniques: spectroscopic, galaxies: evolution, galaxies: general, galaxies: high-redshift, galaxies: ISM, Astrophysics of Galaxies},
         year = 2026,
        month = oct,
       volume = {714},
          eid = {A310},
        pages = {A310},
     abstract = "{How Ly{\ensuremath{\alpha}} photons escape from galaxies during the
        first billion years remains a central question to understanding
        early galaxy evolution and cosmic re-ionisation. While
        Ly{\ensuremath{\alpha}} emitters (LAEs) are known to be metal
        poor and highly ionised, many high-z studies rely on spatially
        integrated measurements, leaving the internal connection between
        Ly{\ensuremath{\alpha}} emission, chemical enrichment, and
        feedback largely unexplored. We present a spatially resolved
        stacking analysis of 287 LAEs at z > 4 observed with
        JWST/NIRSpec prism spectroscopy. By constructing a two-
        dimensional stack from public surveys (CAPERS, CEERS, JADES, and
        RUBIES), we probed the average internal structure of typical
        LAEs (z$_{median}$ = 5.5, M$_{UV,median}$ = -18.7,
        EW(Ly{\ensuremath{\alpha}})$_{median}$ = 61 {\r{A}}) on sub-
        kiloparsec scales. We find a clear radial decoupling between
        resonant and non-resonant emission. While
        EW(H{\ensuremath{\beta}}) and other optical lines decline with
        radius, EW(Ly{\ensuremath{\alpha}}) increases towards the
        outskirts, and the Ly{\ensuremath{\alpha}} escape fraction rises
        from \raisebox{-0.5ex}\textasciitilde16\% in the centre to
        {\ensuremath{\gtrsim}}24\% at larger radii. This behaviour
        suggests that resonant scattering redistributes
        Ly{\ensuremath{\alpha}} photons into outer regions, where escape
        becomes more efficient. Optical diagnostics and T$_{e}$
        measurements in this work reveal low metallicities (12 +
        log(O/H) ≃ 7.7 {\ensuremath{\pm}} 0.2), high ionisation
        parameters, negligible dust attenuation, and systematically
        elevated N/O ratios (log(N/O) \raisebox{-0.5ex}\textasciitilde
        -0.4). The latter place typical LAEs among the growing
        population of nitrogen-enhanced high-redshift galaxies, pointing
        to rapid and possibly feedback-driven chemical enrichment. The
        inferred ionising photon production efficiency,
        log({\ensuremath{\xi}}$_{ion}$/Hz erg$^{-1}$) ≃ 25.1--25.2,
        together with the high Ly{\ensuremath{\alpha}} escape fractions,
        suggests that these systems are efficient, though not extreme,
        contributors to the ionising photon budget. The comparison of
        the observed radial trends of ultraviolet {\ensuremath{\beta}}
        slope, EW(Ly{\ensuremath{\alpha}}), Ly{\ensuremath{\alpha}}
        escape fraction, and metallicity in our LAE stack with results
        from SPICE radiation-hydrodynamic simulations shows that bursty
        supernova feedback models naturally reproduce the observed data,
        linking the spatial redistribution of Ly{\ensuremath{\alpha}} to
        stochastic star formation and feedback-driven gas flows. Our
        results demonstrate that Ly{\ensuremath{\alpha}} emission,
        chemical enrichment, and feedback are tightly connected in
        typical z > 4 LAEs and highlight the power of spatially resolved
        stacking with JWST to uncover the internal physical drivers of
        early galaxy evolution.}",
          doi = {10.1051/0004-6361/202659740},
archivePrefix = {arXiv},
       eprint = {2603.06409},
 primaryClass = {astro-ph.GA},
       adsurl = {https://ui.adsabs.harvard.edu/abs/2026A&A...714A.310T},
